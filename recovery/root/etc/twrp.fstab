# mount point	fstype		device			[device2]

/efs1			emmc		/dev/block/bootdevice/by-name/modemst1		flags=backup=1;display="EFS"
/efs2			emmc		/dev/block/bootdevice/by-name/modemst2		flags=backup=1;subpartitionof=/efs2
/boot			emmc		/dev/block/bootdevice/by-name/boot
/system			ext4		/dev/block/bootdevice/by-name/system
/system_image	emmc		/dev/block/bootdevice/by-name/system
/data			ext4		/dev/block/bootdevice/by-name/userdata		flags=encryptable=footer
/metadata       ext4        /dev/block/bootdevice/by-name/reserve4      flags=display="Metadata";fsflags="discard"
/cache			ext4		/dev/block/bootdevice/by-name/cache
/misc			emmc		/dev/block/bootdevice/by-name/misc
/recovery		emmc		/dev/block/bootdevice/by-name/recovery		flags=backup=1
/vendor			ext4		/dev/block/bootdevice/by-name/oem			flags=wipeingui
/vendor_image	emmc		/dev/block/bootdevice/by-name/oem
/persist		ext4		/dev/block/bootdevice/by-name/persist		flags=display="Persist";backup=1
/firmware		vfat		/dev/block/bootdevice/by-name/modem			flags=display="Firmware";backup=1

/external_sd	auto		/dev/block/mmcblk1p1	/dev/block/mmcblk1	flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg		auto		/dev/block/sda1			/dev/block/sda		flags=display="USB OTG";storage;wipeingui;removable
