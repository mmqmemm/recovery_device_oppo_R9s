# mount point	fstype		device					device2				flags

# Boot & Recovery
/boot			emmc		/dev/block/bootdevice/by-name/boot
/recovery		emmc		/dev/block/bootdevice/by-name/recovery		flags=backup=1

# Cache
/cache			ext4		/dev/block/bootdevice/by-name/cache			flags=fsflags="discard"

# Modem
/firmware		vfat		/dev/block/bootdevice/by-name/modem			flags=display="Firmware";mounttodecrypt
/modem			emmc		/dev/block/bootdevice/by-name/modem			flags=display="Modem";backup=1
/dsp			emmc		/dev/block/bootdevice/by-name/dsp			flags=subpartitionof=/modem;backup=1

# EFS
/efs1			emmc		/dev/block/bootdevice/by-name/modemst1		flags=backup=1;display="EFS"
/efs2			emmc		/dev/block/bootdevice/by-name/modemst2		flags=backup=1;subpartitionof=/efs1
/fsc			emmc		/dev/block/bootdevice/by-name/fsc			flags=backup=1;subpartitionof=/efs1
/fsg			emmc		/dev/block/bootdevice/by-name/fsg			flags=backup=1;subpartitionof=/efs1
/oppostanvbk	emmc		/dev/block/bootdevice/by-name/oppostanvbk	flags=backup=1;subpartitionof=/efs1
/oppodycnvbk	emmc		/dev/block/bootdevice/by-name/oppodycnvbk	flags=backup=1;subpartitionof=/efs1

# Persist
/persist		ext4		/dev/block/bootdevice/by-name/persist		flags=display="Persist";backup=1
/persist_image	emmc		/dev/block/bootdevice/by-name/persist		flags=display="Persist";backup=1;flashimg=1

# Logo
/logo			emmc		/dev/block/bootdevice/by-name/logo			flags=display="Logo";backup=1;flashimg=1

# System & Vendor
/system_root	ext4		/dev/block/bootdevice/by-name/system		flags=display="System";fsflags="discard";wipeingui
/system_image	emmc		/dev/block/bootdevice/by-name/system		flags=display="System";backup=1;flashimg=1
/vendor			ext4		/dev/block/bootdevice/by-name/oem			flags=display="Vendor";fsflags="discard";wipeingui
/vendor_image	emmc		/dev/block/bootdevice/by-name/oem			flags=display="Vendor";backup=1;flashimg=1

# Data
/data			ext4		/dev/block/bootdevice/by-name/userdata		flags=encryptable=footer
/metadata       ext4        /dev/block/bootdevice/by-name/reserve4      flags=display="Metadata";fsflags="discard"
/misc			emmc		/dev/block/bootdevice/by-name/misc

# Removable media
/external_sd	auto		/dev/block/mmcblk1p1	/dev/block/mmcblk1	flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg		auto		/dev/block/sda1			/dev/block/sda		flags=display="USB OTG";storage;wipeingui;removable
